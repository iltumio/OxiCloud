{
	"name": "oxicloud-frontend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && oxlint && oxfmt --check .",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint",
		"format": "oxfmt .",
		"generate:api": "openapi-typescript ../resources/gen/openapi.json -o src/lib/api/generated/schema.d.ts",
		"test:unit": "LANG=C vitest run",
		"test:unit:watch": "LANG=C vitest",
		"test:unit:coverage": "rm -rf ../tests/e2e/.nyc_output_unit && LANG=C COVERAGE=1 vitest run"
	},
	"dependencies": {
		"@tanstack/svelte-query": "^6.1.36",
		"openapi-fetch": "^0.17.0"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		}
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.0",
		"@types/node": "^26.0.0",
		"daisyui": "^5.6.16",
		"jsdom": "^29.1.1",
		"openapi-typescript": "^7.13.0",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"parse5": "^7.3.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"vite": "^8.1.4",
		"vite-plugin-istanbul": "^8.0.0",
		"vitest": "^4.1.10"
	}
}
